{
  "name": "@podyard/mcp",
  "version": "0.1.0",
  "description": "Podyard MCP server - expose Podyard sandboxes to MCP-capable clients",
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "podyard-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "biome check .",
    "clean": "git clean -xdf dist .turbo node_modules",
    "dev": "tsup --watch",
    "fix": "biome check --write .",
    "format": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@podyard/sdk": "^0.2.1",
    "@t3-oss/env-core": "^0.13.11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^25.3.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "ultracite": "^8.2.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
